{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["package.json", "tsconfig.*", "tsdown.config.ts", "src/**/*.tsx?"],
			"outputs": ["cjs/**", "esm/**"]
		},
		"clean": {
			"cache": false
		},
		"coverage": {
			"dependsOn": ["build"],
			"inputs": ["package.json", "tsconfig.*", "vitest.config.ts", "src/**/*.tsx?"],
			"outputs": ["coverage/**"]
		},
		"depcheck": {
			"inputs": ["package.json", "src/**/*.tsx?"]
		},
		"nuke": {
			"cache": false
		},
		"test": {
			"dependsOn": ["build"],
			"inputs": ["package.json", "tsconfig.*", "vitest.config.ts", "src/**/*.tsx?"]
		},
		"typecheck": {
			"inputs": ["package.json", "tsconfig.*", "tsdown.config.ts", "vitest.config.ts", "src/**/*.tsx?"]
		},
		"verify": {
			"dependsOn": ["build"],
			"cache": false
		},
		"watch": {
			"dependsOn": ["build"],
			"inputs": ["package.json", "tsconfig.*", "vitest.config.ts", "src/**/*.tsx?"]
		}
	}
}
